{
  "app_name": "example-pipeline",
  "renderer_version": "0.1.0",
  "workload": "pipeline",
  "environment": "staging",
  "groups": [
    {
      "name": "worker",
      "region": "cdg",
      "guest": {
        "cpu_kind": "shared",
        "cpus": 2,
        "memory_mb": 1024
      },
      "min_machines": 3,
      "max_machines": 8,
      "restart": "on-failure",
      "metadata": {
        "fly.environment": "staging",
        "fly.renderer-version": "0.1.0",
        "fly.workload": "pipeline",
        "flydeploy.group": "worker"
      },
      "containers": [
        {
          "name": "worker",
          "image": "registry.example/pipeline/worker@sha256:9999999999999999999999999999999999999999999999999999999999999999",
          "image_digest": "sha256:9999999999999999999999999999999999999999999999999999999999999999",
          "env": {
            "QUEUE_URL": "amqp://queue.internal"
          },
          "restart": "on-failure"
        }
      ]
    }
  ]
}
